# Sample values only. Copy this file to .env; never commit .env.
PORT=3000
# This local example matches compose.yaml. For Atlas, replace the entire value
# with your own cluster connection string and database name.
MONGO_URI=mongodb://127.0.0.1:27017/p09_real_estate?replicaSet=rs0&directConnection=true
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS
JWT_EXPIRY=2h
NODE_ENV=development

# Required only when running npm run seed:admin. No default admin is bundled.
ADMIN_NAME=REPLACE_WITH_ADMIN_NAME
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_STRONG_PASSWORD

# Development demo limits; in-memory and per IP. Adjust for your deployment.
AUTH_RATE_LIMIT_MAX=100
API_RATE_LIMIT_MAX=600
